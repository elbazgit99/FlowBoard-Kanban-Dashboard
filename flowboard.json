          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Card": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status",
          "priority",
          "assignee",
          "dueDate",
          "tags",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identifiant auto-incrémenté.",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nom d’un membre de GET /members, ou null."
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "YYYY-MM-DD"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            },
            "maxItems": 10
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "CardInput": {
        "type": "object",
        "description": "Corps de POST et PUT. Les clés inconnues, `id`, `createdAt` et `updatedAt` sont ignorés.",
        "required": [
          "title",
          "status",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80,
            "description": "Espaces de début et de fin retirés. Le HTML n’est pas nettoyé."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300,
            "default": ""
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "Doit correspondre exactement au `name` d’un membre."
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "default": null
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "maxItems": 10,
            "default": []
          }
        }
      },
      "CardPatch": {
        "type": "object",
        "description": "Corps de PATCH : tous les champs de CardInput sont facultatifs.",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "done"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "name",
          "initials"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "error",
          "details"
        ],
        "properties": {
          "error": {
            "const": "ValidationError"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Identifiant numérique.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      },
      "Workspace": {
        "name": "X-Workspace",
        "in": "header",
        "required": false,
        "description": "Espace de travail personnel (1 à 32 caractères a-z, 0-9, - et _). Par défaut : public.",
        "schema": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,32}$",
          "default": "public"
        }
      },
      "Delay": {
        "name": "_delay",
        "in": "query",
        "required": false,
        "description": "Retarde la réponse de N millisecondes (5000 au maximum).",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      },
      "Password": {
        "name": "password",
        "in": "query",
        "required": false,
        "description": "Mot de passe des écritures (POST, PUT, PATCH, DELETE), exigé quand le serveur en définit un.",
        "schema": {
          "type": "string"
        }
      },
      "Fail": {
        "name": "_fail",
        "in": "query",
        "required": false,
        "description": "Force une erreur HTTP sans exécuter la requête.",
        "schema": {
          "type": "integer",
          "enum": [
            404,
            500,
            503
          ]
        }
      }
    },
    "headers": {
      "XTotalCount": {
        "description": "Nombre total d’éléments correspondant aux filtres, avant pagination.",
        "schema": {
          "type": "integer"
        }
      },
      "Link": {
        "description": "Avec `_page` : liens vers les pages first, prev, next et last.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Ressource introuvable : objet vide, comme json-server.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            },
            "example": {}
          }
        }
      },
      "ValidationError": {
        "description": "Données invalides.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "example": {
              "error": "ValidationError",
              "details": [
                {
                  "field": "title",
                  "message": "title doit contenir au moins 3 caractères."
                }
              ]
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite de débit atteinte.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Secondes à attendre."
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "const": "TooManyRequests"
                },
                "message": {
                  "type": "string"
                },
                "retryAfter": {
                  "type": "integer"
                }
              }
            },
            "example": {
              "error": "TooManyRequests",
              "message": "Trop de requêtes…",
              "retryAfter": 42
            }
          }
        }
      },
      "ServerError": {
        "description": "Erreur serveur (réelle ou simulée avec `_fail=500`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "InternalServerError",
              "message": "Erreur serveur simulée (_fail=500)."
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Mot de passe des écritures absent ou incorrect : rien n’a été modifié.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Unauthorized",
              "message": "Les ajouts, modifications et suppressions exigent le paramètre ?password=…"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Service indisponible (simulé avec `_fail=503`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "ServiceUnavailable",
              "message": "Service indisponible simulé (_fail=503)."
            }
          }
        }
      }
    }
  }
}